# Copy to .env and replace placeholders; never commit .env or secrets/.
SOLARWINDS_BASE_URL=https://solarwinds.example.org:17774/SolarWinds/InformationService/v3/Json
SOLARWINDS_USERNAME=readonly_user
SOLARWINDS_PASSWORD=REPLACE_ME
SOLARWINDS_CA_CERT_PATH=/run/secrets/your-ca.pem
SOLARWINDS_PINNED_CERT_SHA256=REPLACE_ME
SOLARWINDS_TIMEOUT_MS=10000
SOLARWINDS_MAX_RESULTS=100
MCPO_API_KEY=REPLACE_ME
